# Docker Compose interpolation values.
# Copy this file to deploy/.env and keep the copy untracked.

DIFFAUDIT_IMAGE_TAG=local
# For GHCR published images:
# DIFFAUDIT_IMAGE=ghcr.io/deliciousbuding/diffaudit-platform
# DIFFAUDIT_IMAGE_TAG=sha-<short-sha>

# Bind locally by default. Put public TLS/proxy settings outside this repository.
DIFFAUDIT_BIND=127.0.0.1:3000

# Host path containing sanitized public snapshot files.
DIFFAUDIT_PUBLIC_SNAPSHOT_DIR=./snapshots/public

# Filled by build scripts for traceable builds.
DIFFAUDIT_VCS_REF=unknown
DIFFAUDIT_BUILD_DATE=unknown
